@prefix ex:     <https://example.org/medical-access/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@base           <https://example.org/medical-access/> .

<ontology/medical-access>
    a owl:Ontology ;
    rdfs:label "Medical Access Ontology"@en , "地域医療アクセスオントロジー"@ja ;
    rdfs:comment "医療機関・診療科・診療時間・所在地を統合するための語彙。"@ja .

ex:ClinicalService
    a rdfs:Class , owl:Class ;
    rdfs:label "診療サービス"@ja , "Clinical Service"@en ;
    rdfs:comment "医療機関が提供する診療科単位のサービス。医療機関と診療科・診療時間を橋渡しする中間ノード。"@ja .

ex:facilityId
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "施設ID"@ja ;
    rdfs:domain schema:MedicalOrganization ;
    rdfs:range xsd:string ;
    rdfs:comment "データ提供元が付与する安定した施設識別子。"@ja .

ex:offersClinicalService
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "診療サービス提供"@ja ;
    rdfs:domain schema:MedicalOrganization ;
    rdfs:range ex:ClinicalService .

ex:medicalSpecialty
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "診療科"@ja ;
    rdfs:domain ex:ClinicalService ;
    rdfs:range skos:Concept .

ex:hasSchedule
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "診療時間"@ja ;
    rdfs:domain ex:ClinicalService ;
    rdfs:range schema:OpeningHoursSpecification .

<concept/specialty>
    a skos:ConceptScheme ;
    skos:prefLabel "標榜診療科"@ja , "Medical Specialties"@en ;
    rdfs:comment "本 LOD で用いる診療科の概念スキーム。個々の skos:Concept は出典 (厚生労働省 医療情報ネット) が付与する 4 桁の診療科コード (例: 1001=内科, 3001=小児科, 6001=皮膚科) を skos:notation とし、ラベルを skos:prefLabel@ja で保持する。公式標榜診療科コード体系が確定した際は skos:exactMatch で接続する。実際の Concept 集合はデータ (medical-access-lod.ttl) 側で提供される。"@ja .
